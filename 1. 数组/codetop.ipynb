   "source": [
    "nums = [1, 1, 2, 2, 3]\n",
    "\n",
    "slow = 0\n",
    "\n",
    "for fast in range(1, len(nums)):\n",
    "    print(f\"fast: {fast}, slow: {slow}, nums: {nums}\")\n",
    "    if nums[fast] != nums[slow]:\n",
    "        slow += 1\n",
    "        nums[slow] = nums[fast]\n"
   ]
